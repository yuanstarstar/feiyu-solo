# 肥鱼喂饭站 · 单鱼版（feiyu-solo）
# 用法：cp .env.example .env → 填 SPONSOR_CREDENTIAL（或在网页/CLI 里绑）→ chmod 600 .env
# 注意：systemd 的 EnvironmentFile 不做 shell 展开，等号两边别加空格、值别加引号。

HOST=127.0.0.1
PORT=8790

# ---- 绑定这只鱼（三选一）----
# 1) 在这里给凭证，首次启动自动绑定（之后可以删掉这一行）
# SPONSOR_CREDENTIAL=
# 2) node setup.mjs
# 3) 网页里填（需要下面这个 setup token）

# 凭证形态：platform = DSH 客户端那份 64 位平台凭证（走 x-dsh-auth-token）
#           session  = 浏览器登录后的会话 token（走 Authorization: Bearer，会过期）
SPONSOR_AUTH_MODE=platform

# 网页绑定的门票：设了它，POST /api/setup 必须带同样的 x-setup-token；不设则网页绑定关闭
# SPONSOR_SETUP_TOKEN=

# 资料（用环境变量绑定时生效）
SPONSOR_NAME=本鲸
SPONSOR_TAGLINE=饿了，谢谢投喂
# SPONSOR_BIO=
# SPONSOR_TAGS=写代码,聊天
# SPONSOR_TARGET_CENTS=2000
# SPONSOR_HUE=214

# ---- 加密 ----
# 留空则首次启动自动生成 data/solo-vault.key（0600）。
# 设了之后不要再改，也不要用大站(ai-sponsor)的 key —— 两边域不同，密文不通用。
SPONSOR_VAULT_KEY=
# 数据目录，默认站点根下的 data/
# SPONSOR_DATA_DIR=/opt/feiyu-solo/data

# 只在“确实有反向代理”时打开（否则可伪造 XFF 绕封禁；反之在反代后不开会把所有人算成同一 IP）
SPONSOR_TRUST_PROXY=0

# ---- 可调规则（分 / 毫秒）----
SPONSOR_MIN_CENTS=100
SPONSOR_ORDER_TTL_MS=900000
SPONSOR_BAN_FIRST_MS=3600000
SPONSOR_BAN_REPEAT_MS=86400000

# 【危险】测试模式：/api/_test/* 可把订单直接标记成已付款，生产不要开
# SPONSOR_TEST=1
